# Postgres. Local dev database: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="postgresql://ranchi:ranchi@localhost:5433/ranchi"

# iron-session cookie encryption (min 32 chars)
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Public app URL (Paystack callbacks)
APP_URL="http://localhost:3000"

# Paystack (leave empty or set PAYSTACK_DRY_RUN=true for local mock checkout)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_DRY_RUN="true"

# StronPower — when true, GenStoreVendingData is skipped and a dry-run PIN is returned
STRON_DRY_RUN="true"

# Optional defaults used by seed only
STRON_BASE_URL="https://stronpower.example.com"
STRON_COMPANY_NAME="DemoCompany"
STRON_USERNAME="demo_user"
STRON_PASSWORD="demo_pass"
