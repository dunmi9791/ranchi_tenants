# Copy to .env.docker and fill in. Used by docker-compose.yml. Never commit .env.docker.

# Postgres (the db and backup containers read these). Generate a password with: openssl rand -hex 24
POSTGRES_USER=ranchi
POSTGRES_PASSWORD=
POSTGRES_DB=ranchi
# The app's connection string: same user / password / db, host "db". URL-encode special
# characters in the password (a hex password needs none).
DATABASE_URL=postgresql://ranchi:PASSWORD@db:5432/ranchi

# Public URL the app is reached at (Paystack redirects here). Use https:// in production —
# login cookies are only marked Secure when this starts with https://.
APP_URL=https://tenants.example.com

# iron-session cookie encryption — at least 32 random characters.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# First admin account, created on startup only if no admin exists yet (min 8 chars).
# Remove ADMIN_PASSWORD after the first successful start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack. Use sk_test_ keys while testing, sk_live_ keys in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_DRY_RUN=false

# StronPower. true = never issue real tokens (dry-run PINs, company "dry-run price" is used).
STRON_DRY_RUN=false
